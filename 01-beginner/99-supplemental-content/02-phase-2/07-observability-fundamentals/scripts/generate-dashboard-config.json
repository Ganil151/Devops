{
  "dashboard": {
    "id": null,
    "title": "Production Overview",
    "timezone": "browser",
    "panels": [
      {
        "title": "CPU Usage",
        "type": "graph",
        "gridPos": { "x": 0, "y": 0, "w": 12, "h": 9 },
        "targets": [
          {
            "expr": "node_cpu_usage",
            "legendFormat": "{{instance}}"
          }
        ]
      },
      {
        "title": "Memory Usage",
        "type": "gauge",
        "gridPos": { "x": 12, "y": 0, "w": 12, "h": 9 },
        "targets": [
          {
            "expr": "node_memory_usage"
          }
        ]
      }
    ]
  },
  "overwrite": true
}
