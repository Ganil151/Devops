{
  "// AI Toolkit Configuration": "Configuration for AI-assisted development",
  
  "aiToolkit.enabled": true,
  "aiToolkit.version": "1.0",
  
  "aiToolkit.tools": {
    "agentCodeGenBestPractices": {
      "enabled": true,
      "description": "Best practices for AI Agent development"
    },
    "tracingCodeGenBestPractices": {
      "enabled": true,
      "description": "Tracing implementation for AI applications"
    },
    "aiModelGuidance": {
      "enabled": true,
      "description": "Model selection and configuration guidance"
    },
    "evaluationPlanner": {
      "enabled": true,
      "priority": "high",
      "notes": "Call this FIRST when metrics are unclear"
    },
    "evaluationCodeGenBestPractices": {
      "enabled": true,
      "prerequisite": "evaluationPlanner"
    },
    "evaluationAgentRunner": {
      "enabled": true,
      "description": "Agent runners for test dataset evaluation"
    }
  },
  
  "aiToolkit.workflows": {
    "newAgentProject": {
      "order": 1,
      "steps": [
        "agentCodeGenBestPractices",
        "tracingCodeGenBestPractices",
        "aiModelGuidance",
        "evaluationPlanner",
        "evaluationCodeGenBestPractices",
        "evaluationAgentRunner"
      ]
    },
    "evaluationFocused": {
      "order": 2,
      "steps": [
        "evaluationPlanner",
        "evaluationCodeGenBestPractices",
        "evaluationAgentRunner",
        "tracingCodeGenBestPractices"
      ]
    }
  },
  
  "aiToolkit.codeGeneration": {
    "defaultLanguage": "bash",
    "supportedLanguages": [
      "bash",
      "python",
      "json",
      "yaml",
      "markdown"
    ],
    "filePathComments": true,
    "syntaxValidation": true,
    "backupBeforeApply": true
  },
  
  "aiToolkit.evaluation": {
    "metricsRequired": true,
    "testDatasetRequired": true,
    "minTestSamples": 10,
    "successThreshold": 0.85
  },
  
  "aiToolkit.project": {
    "name": "DevOps Automation Suite",
    "directory": "${workspaceFolder}",
    "scriptDirectory": "00-Resources/01-Scripts-Code",
    "backupLocation": ".ai-backups"
  },
  
  "// Other VS Code Settings": "Configure below as needed",
  
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "files.exclude": {
    "**/.ai-backups": true,
    "**/*.backup.*": true
  },
  "search.exclude": {
    ".ai-backups": true
  }
}