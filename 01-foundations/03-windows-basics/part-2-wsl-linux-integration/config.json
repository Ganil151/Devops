{
  "script": {
    "name": "DevSecOps-Bootstrap",
    "version": "4.0.0-UNIFIED",
    "author": "Senior Principal DevSecOps Engineer",
    "license": "MIT"
  },
  "tools": {
    "core": [
      {
        "name": "awscli",
        "command": "aws",
        "version_arg": "--version",
        "display_name": "AWS CLI",
        "install_methods": {
          "windows": {"choco": "awscli"},
          "linux": {"dnf": "awscli", "pip": "awscli"}
        }
      },
      {
        "name": "terraform",
        "command": "terraform",
        "version_arg": "--version",
        "display_name": "Terraform",
        "install_methods": {
          "windows": {"choco": "terraform"},
          "linux": {"repo": "hashicorp", "dnf": "terraform"}
        }
      },
      {
        "name": "terragrunt",
        "command": "terragrunt",
        "version_arg": "--version",
        "display_name": "Terragrunt",
        "install_methods": {
          "windows": {"choco": "terragrunt"},
          "linux": {
            "dnf": "terragrunt",
            "github": {
              "repo": "gruntwork-io/terragrunt",
              "pattern": "terragrunt_linux_{ARCH}",
              "binary_name": "terragrunt"
            }
          }
        }
      },
      {
        "name": "kubernetes-cli",
        "command": "kubectl",
        "version_arg": "version --client",
        "display_name": "Kubectl",
        "install_methods": {
          "windows": {"choco": "kubernetes-cli"},
          "linux": {"repo": "kubernetes", "dnf": "kubectl"}
        }
      },
      {
        "name": "helm",
        "command": "helm",
        "version_arg": "version",
        "display_name": "Helm",
        "install_methods": {
          "windows": {"choco": "helm"},
          "linux": {
            "dnf": "helm",
            "script": "https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3"
          }
        }
      },
      {
        "name": "docker-desktop",
        "command": "docker",
        "version_arg": "--version",
        "display_name": "Docker Engine",
        "install_methods": {
          "windows": {"choco": "docker-desktop"},
          "linux": {"repo": "docker-ce", "dnf": "docker-ce docker-ce-cli containerd.io docker-compose-plugin"}
        },
        "skip_flag": "skip_docker"
      },
      {
        "name": "git",
        "command": "git",
        "version_arg": "--version",
        "display_name": "Git",
        "install_methods": {
          "windows": {"choco": "git"},
          "linux": {"dnf": "git"}
        }
      }
    ],
    "build": [
      {
        "name": "temurin21",
        "command": "java",
        "version_arg": "-version",
        "display_name": "OpenJDK 21 (Temurin)",
        "env_vars": {"JAVA_HOME": "auto_detect"},
        "install_methods": {
          "windows": {"choco": "temurin21"},
          "linux": {"repo": "adoptium", "dnf": "temurin-21-jdk"}
        }
      },
      {
        "name": "maven",
        "command": "mvn",
        "version_arg": "--version",
        "display_name": "Apache Maven",
        "env_vars": {"M2_HOME": "/usr/share/maven"},
        "install_methods": {
          "windows": {"choco": "maven"},
          "linux": {"dnf": "maven"}
        }
      }
    ],
    "security": [
      {
        "name": "trivy",
        "command": "trivy",
        "version_arg": "--version",
        "display_name": "Trivy Scanner",
        "install_methods": {
          "windows": {"choco": "trivy"},
          "linux": {
            "dnf": "trivy",
            "github": {
              "repo": "aquasecurity/trivy",
              "pattern": "trivy_*_Linux-64bit.tar.gz",
              "extract": true,
              "binary_name": "trivy"
            }
          }
        }
      },
      {
        "name": "sonarscanner",
        "command": "sonar-scanner",
        "version_arg": "--version",
        "display_name": "SonarQube Scanner",
        "env_vars": {"SONAR_SCANNER_HOME": "/opt/sonar-scanner"},
        "install_methods": {
          "linux": {
            "direct": {
              "url": "https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/sonar-scanner-cli-4.8.0.2856-linux.zip",
              "extract_to": "/opt/sonar-scanner",
              "bin_subdir": "bin"
            }
          }
        }
      },
      {
        "name": "checkov",
        "command": "checkov",
        "version_arg": "--version",
        "display_name": "Checkov",
        "install_methods": {
          "windows": {"pip": "checkov"},
          "linux": {"pip": "checkov"}
        },
        "requires_pip": true
      }
    ],
    "utilities": [
      {
        "name": "jq",
        "command": "jq",
        "version_arg": "--version",
        "display_name": "JQ Utility",
        "install_methods": {
          "windows": {"choco": "jq"},
          "linux": {"dnf": "jq"}
        }
      },
      {
        "name": "yq",
        "command": "yq",
        "version_arg": "--version",
        "display_name": "YQ Utility",
        "install_methods": {
          "windows": {"choco": "yq"},
          "linux": {
            "dnf": "yq",
            "github": {
              "repo": "mikefarah/yq",
              "pattern": "yq_linux_{ARCH}",
              "binary_name": "yq"
            }
          }
        }
      },
      {
        "name": "ansible",
        "command": "ansible",
        "version_arg": "--version",
        "display_name": "Ansible",
        "install_methods": {
          "windows": {"pip": "ansible-core", "wsl_required": true},
          "linux": {"dnf": "ansible", "pip": "ansible-core"}
        },
        "requires_pip": true
      }
    ]
  },
  "repositories": {
    "hashicorp": {
      "linux": "https://rpm.releases.hashicorp.com/fedora/hashicorp.repo",
      "windows": null
    },
    "kubernetes": {
      "linux": "https://pkgs.k8s.io/core:/stable:/v1.29/rpm/",
      "windows": null
    },
    "docker-ce": {
      "linux": "https://download.docker.com/linux/fedora/docker-ce.repo",
      "windows": null
    },
    "adoptium": {
      "linux": "https://packages.adoptium.net/artifactory/rpm/fedora/$releasever/$basearch/",
      "windows": null
    },
    "rpmfusion": {
      "linux": {
        "free": "https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-{VERSION}.noarch.rpm",
        "nonfree": "https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-{VERSION}.noarch.rpm"
      }
    }
  },
  "defaults": {
    "log_dir": {
      "windows": "$env:TEMP\\DevSecOps-Provisioner",
      "linux": "$HOME/.devsecops-provisioner"
    },
    "install_prefix": {
      "windows": "C:\\ProgramData\\chocolatey\\lib",
      "linux": "/usr/local"
    }
  }
}