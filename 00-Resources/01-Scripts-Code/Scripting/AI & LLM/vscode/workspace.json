{
  "// AI Toolkit - DevOps Project Settings": "Workspace-specific configuration",
  
  "aiToolkit.enabled": true,
  "aiToolkit.version": "1.0",
  
  "aiToolkit.project": {
    "name": "DevOps Automation Suite",
    "directory": "${workspaceFolder}",
    "scriptDirectory": "00-Resources/01-Scripts-Code",
    "backupLocation": ".ai-backups"
  },
  
  "aiToolkit.tools": {
    "agentCodeGenBestPractices": { "enabled": true },
    "tracingCodeGenBestPractices": { "enabled": true },
    "aiModelGuidance": { "enabled": true },
    "evaluationPlanner": { "enabled": true, "priority": "high" },
    "evaluationCodeGenBestPractices": { "enabled": true },
    "evaluationAgentRunner": { "enabled": true }
  },
  
  "aiToolkit.codeGeneration": {
    "defaultLanguage": "bash",
    "filePathComments": true,
    "syntaxValidation": true,
    "backupBeforeApply": true
  },
  
  "[bash]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
    "editor.formatOnSave": true
  },
  
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": true
  }
}